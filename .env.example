NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Origin the site is served from, including protocol and no trailing slash
# (e.g. https://www.baitulaqba.org). Drives canonical URLs, Open Graph tags,
# robots.txt and sitemap.xml, so it must match the live host exactly — including
# the www. subdomain. Optional: defaults to the production domain in
# src/lib/seo.ts. Set this on preview/staging deployments.
NEXT_PUBLIC_SITE_URL=
